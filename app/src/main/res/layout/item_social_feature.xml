<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    app:cardCornerRadius="18dp" app:strokeColor="?attr/colorPrimary" app:strokeWidth="1dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/socialFeatureImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/linear_gradient_nav"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="18dp">
            <TextView android:id="@+id/socialFeatureTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_bold" android:textColor="@color/bg_white" android:textSize="20sp"/>
            <TextView android:id="@+id/socialFeatureSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/bg_white" android:alpha="0.82" android:textSize="12sp"/>
        </LinearLayout>
        <ImageView android:id="@+id/socialFeatureArrow" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:src="@drawable/ic_shinigami_arrow" app:tint="@color/bg_white"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>