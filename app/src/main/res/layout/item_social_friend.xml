<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:gravity="center" android:orientation="vertical">
 <FrameLayout android:layout_width="58dp" android:layout_height="58dp">
  <com.google.android.material.imageview.ShapeableImageView android:id="@+id/socialFriendAvatar" android:layout_width="58dp" android:layout_height="58dp" app:shapeAppearanceOverlay="@style/roundedImageView"/>
  <View android:id="@+id/socialFriendDot" android:layout_width="13dp" android:layout_height="13dp" android:layout_gravity="bottom|end" android:background="@drawable/item_ongoing"/>
 </FrameLayout>
 <TextView android:id="@+id/socialFriendName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="?attr/colorOnBackground" android:textSize="10sp"/>
 <TextView android:id="@+id/socialFriendStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="?attr/colorPrimary" android:textSize="9sp"/>
</LinearLayout>