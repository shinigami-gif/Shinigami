<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/scheduleTime"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:fontFamily="@font/poppins_bold"
        android:textColor="?attr/colorOnBackground"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/scheduleCard"
        app:layout_constraintBottom_toBottomOf="@id/scheduleCard" />

    <View
        android:id="@+id/scheduleLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="?attr/colorOutline"
        app:layout_constraintStart_toEndOf="@id/scheduleTime"
        app:layout_constraintTop_toTopOf="@id/scheduleCard"
        app:layout_constraintBottom_toBottomOf="@id/scheduleCard" />

    <View
        android:id="@+id/scheduleDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/item_ongoing"
        app:layout_constraintStart_toStartOf="@id/scheduleLine"
        app:layout_constraintEnd_toEndOf="@id/scheduleLine"
        app:layout_constraintTop_toTopOf="@id/scheduleCard"
        android:translationX="-5dp"
        android:translationZ="4dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scheduleCard"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toEndOf="@id/scheduleLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="7dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/scheduleCover"
                android:transitionName="mediaCover"
                android:layout_width="66dp"
                android:layout_height="94dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/roundedImageView" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/scheduleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/scheduleEpisode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/scheduleMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/scheduleGenres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/scheduleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/item_score"
                    android:paddingStart="7dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="5dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/scheduleRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:alpha="0.7"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
